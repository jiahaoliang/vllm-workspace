{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-ascend.local/blockwise-dsa/npu-e2e/run-config.schema.json",
  "title": "Blockwise DSA NPU E2E run configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "namespace",
    "artifact_root",
    "kube_context",
    "target_node",
    "images",
    "revisions",
    "model",
    "topology",
    "resources",
    "commands",
    "client",
    "oracle",
    "identity",
    "capabilities"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {
      "type": "string",
      "maxLength": 35,
      "pattern": "^dsa-npu-[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "namespace": {"const": "liangjiahao"},
    "artifact_root": {"type": "string", "pattern": "^/"},
    "kube_context": {"type": "string", "minLength": 1},
    "target_node": {"type": "string", "minLength": 1},
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "prefill", "decode", "default_v1", "client"],
      "properties": {
        "baseline": {"$ref": "#/$defs/image"},
        "prefill": {"$ref": "#/$defs/image"},
        "decode": {"$ref": "#/$defs/image"},
        "default_v1": {"$ref": "#/$defs/image"},
        "client": {"$ref": "#/$defs/image"}
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vllm", "vllm_ascend", "mooncake", "cann", "torch_npu"],
      "properties": {
        "vllm": {"$ref": "#/$defs/nonempty"},
        "vllm_ascend": {"$ref": "#/$defs/nonempty"},
        "mooncake": {"$ref": "#/$defs/nonempty"},
        "cann": {"$ref": "#/$defs/nonempty"},
        "torch_npu": {"$ref": "#/$defs/nonempty"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "model_revision",
        "tokenizer_revision",
        "configuration_fingerprint",
        "cache_dtype",
        "block_size",
        "max_model_len",
        "sampling"
      ],
      "properties": {
        "model_id": {"$ref": "#/$defs/nonempty"},
        "model_revision": {"$ref": "#/$defs/nonempty"},
        "tokenizer_revision": {"$ref": "#/$defs/nonempty"},
        "configuration_fingerprint": {"$ref": "#/$defs/sha256"},
        "cache_dtype": {"$ref": "#/$defs/nonempty"},
        "block_size": {"type": "integer", "minimum": 1},
        "max_model_len": {"type": "integer", "minimum": 1},
        "sampling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temperature", "top_p", "seed"],
          "properties": {
            "temperature": {"const": 0},
            "top_p": {"const": 1},
            "seed": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefill_tp",
        "prefill_dp",
        "decode_tp",
        "decode_dp",
        "decode_pp",
        "decode_dcp",
        "decode_pcp",
        "routes"
      ],
      "properties": {
        "prefill_tp": {"type": "integer", "minimum": 1},
        "prefill_dp": {"type": "integer", "minimum": 1},
        "decode_tp": {"type": "integer", "minimum": 1},
        "decode_dp": {"type": "integer", "minimum": 1},
        "decode_pp": {"const": 1},
        "decode_dcp": {"type": "integer", "minimum": 1},
        "decode_pcp": {"type": "integer", "minimum": 1},
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decode_dp_rank",
              "prefill_dp_rank",
              "prefill_endpoint",
              "decode_tp_leaders"
            ],
            "properties": {
              "decode_dp_rank": {"type": "integer", "minimum": 0},
              "prefill_dp_rank": {"type": "integer", "minimum": 0},
              "prefill_endpoint": {"$ref": "#/$defs/nonempty"},
              "decode_tp_leaders": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npu_resource_name", "baseline_npu", "prefill_npu", "decode_npu"],
      "properties": {
        "npu_resource_name": {"const": "huawei.com/Ascend910"},
        "baseline_npu": {"type": "integer", "minimum": 1},
        "prefill_npu": {"type": "integer", "minimum": 1},
        "decode_npu": {"type": "integer", "minimum": 1}
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "prefill", "decode", "default_v1_prefill", "default_v1_decode", "session_cleanup"],
      "properties": {
        "baseline": {"$ref": "#/$defs/command"},
        "prefill": {"$ref": "#/$defs/command"},
        "decode": {"$ref": "#/$defs/command"},
        "default_v1_prefill": {"$ref": "#/$defs/command"},
        "default_v1_decode": {"$ref": "#/$defs/command"},
        "session_cleanup": {"$ref": "#/$defs/command"}
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "service_port", "active_deadline_seconds"],
      "properties": {
        "command": {"$ref": "#/$defs/command"},
        "service_port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "active_deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 7200}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atol", "rtol", "cache_layers"],
      "properties": {
        "atol": {"type": "number", "minimum": 0},
        "rtol": {"type": "number", "minimum": 0},
        "cache_layers": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "integer", "minimum": 0}
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positional_abi_fingerprint", "fixture_sha256", "case_catalog_sha256"],
      "properties": {
        "positional_abi_fingerprint": {"$ref": "#/$defs/sha256"},
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "case_catalog_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/capability"},
      "required": [
        "case_client",
        "tokenizer_roundtrip",
        "output_oracle",
        "cache_probe",
        "lifecycle_probe",
        "leader_replica_evidence",
        "memory_placement_probe",
        "fused_d2h_probe",
        "reservation_probe",
        "admission_barrier",
        "phase_fault",
        "tp_terminal_barrier",
        "preemption_control",
        "cancellation_control",
        "default_v1_probe",
        "session_cleanup",
        "resource_inventory"
      ]
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "image": {
      "type": "string",
      "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "sha256", "notes"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "evidence": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "PASS"}}},
          "then": {
            "properties": {
              "evidence": {"type": "string", "pattern": "^/"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      ]
    }
  }
}
