{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-ascend.local/blockwise-dsa/npu-e2e/fixture.schema.json",
  "title": "One frozen Blockwise DSA NPU request fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "prompt_token_ids",
    "max_tokens",
    "expected_prompt_tokens",
    "expected_reservation_blocks",
    "purpose",
    "input_sha256"
  ],
  "properties": {
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "prompt_token_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 0}
    },
    "max_tokens": {"type": "integer", "minimum": 0},
    "expected_prompt_tokens": {"type": "integer", "minimum": 1},
    "expected_reservation_blocks": {"type": "integer", "minimum": 1},
    "purpose": {"type": "string", "minLength": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
