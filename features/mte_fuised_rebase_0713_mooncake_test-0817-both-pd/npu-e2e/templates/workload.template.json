{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "UNRESOLVED-config",
        "namespace": "liangjiahao",
        "labels": {
          "app.kubernetes.io/managed-by": "dsa-npu-e2e",
          "test-run": "UNRESOLVED",
          "test-role": "UNRESOLVED"
        }
      },
      "data": {"run-config.json": "UNRESOLVED"}
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "UNRESOLVED",
        "namespace": "liangjiahao",
        "labels": {
          "app.kubernetes.io/managed-by": "dsa-npu-e2e",
          "test-run": "UNRESOLVED",
          "test-role": "UNRESOLVED",
          "dp-rank": "UNRESOLVED"
        }
      },
      "spec": {
        "replicas": 1,
        "selector": {"matchLabels": {"test-run": "UNRESOLVED", "workload-name": "UNRESOLVED"}},
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/managed-by": "dsa-npu-e2e",
              "test-run": "UNRESOLVED",
              "test-role": "UNRESOLVED",
              "workload-name": "UNRESOLVED",
              "dp-rank": "UNRESOLVED"
            }
          },
          "spec": {
            "restartPolicy": "Always",
            "nodeSelector": {"kubernetes.io/hostname": "UNRESOLVED"},
            "containers": [
              {
                "name": "server",
                "image": "UNRESOLVED@sha256:UNRESOLVED",
                "imagePullPolicy": "IfNotPresent",
                "command": ["UNRESOLVED"],
                "env": [
                  {"name": "DSA_E2E_RUN_ID", "value": "UNRESOLVED"},
                  {"name": "DSA_E2E_ROLE", "value": "UNRESOLVED"},
