                "ports": [{"name": "http", "containerPort": 8000}],
                "resources": {
                  "requests": {"huawei.com/Ascend910": "1"},
                  "limits": {"huawei.com/Ascend910": "1"}
                },
                "volumeMounts": [{"name": "run-config", "mountPath": "/opt/dsa-e2e", "readOnly": true}]
              }
            ],
            "volumes": [{"name": "run-config", "configMap": {"name": "UNRESOLVED-config"}}]
          }
