+def emit_load_timing_event(
+    stage: str,
+    *,
+    step_id: int,
+    layer_id: int,
+    tp_rank: int,
+    duration_us: int,
+    details: dict[str, object] | None = None,
+) -> None:
+    """Emit opt-in timing for one layer-load boundary."""
+    try:
+        if os.getenv("VLLM_ASCEND_KVPOOL_LOAD_TIMING_DEBUG", "0") != "1":
+            return
+        payload: dict[str, object] = {
+            "event": "load_timing",
+            "stage": stage,
+            "step_id": int(step_id),
+            "layer_id": int(layer_id),
+            "tp_rank": int(tp_rank),
+            "duration_us": int(duration_us),
+        }
+        if details:
+            payload.update(details)
+        logger.info(
+            "%s %s",
+            LOAD_TIMING_DEBUG_PREFIX,
+            json.dumps(payload, separators=(",", ":")),
+        )
+    except Exception:
+        pass
