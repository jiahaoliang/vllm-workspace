+def _mstx_message(
+    stage: str,
+    *,
+    step_id: int,
+    layer_id: int,
+    tp_rank: int,
+    request_id: str | None = None,
+    queue_wait_us: int | None = None,
+) -> str:
+    fields = [
+        f"domain={MSTX_DOMAIN}",
+        f"stage={stage}",
+        f"step_id={int(step_id)}",
+        f"layer_id={int(layer_id)}",
+        f"tp_rank={int(tp_rank)}",
+    ]
+    if request_id is not None:
+        fields.append(f"request_id={request_id}")
+    if queue_wait_us is not None:
+        fields.append(f"queue_wait_us={int(queue_wait_us)}")
+    return " ".join(fields)
