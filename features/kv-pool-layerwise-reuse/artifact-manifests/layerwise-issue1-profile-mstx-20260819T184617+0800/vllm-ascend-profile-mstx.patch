+def _mstx_enabled(*, request_scoped: bool = False) -> bool:
+    if os.getenv("VLLM_ASCEND_KVPOOL_MSTX_DEBUG", "0") != "1":
+        return False
+    return not request_scoped or os.getenv(
+        "VLLM_ASCEND_KVPOOL_MSTX_REQUEST_SCOPES", "0"
+    ) == "1"
+
