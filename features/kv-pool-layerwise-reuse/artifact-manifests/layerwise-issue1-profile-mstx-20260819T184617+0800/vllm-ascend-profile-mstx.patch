+
+def end_mstx_load_range(range_id: int | None) -> None:
+    """End a Host range; diagnostic failures must never affect inference."""
+    try:
+        if range_id is None:
+            return
+        import torch_npu
+
+        torch_npu.npu.mstx.range_end(range_id, domain=MSTX_DOMAIN)
+    except Exception:
+        pass
