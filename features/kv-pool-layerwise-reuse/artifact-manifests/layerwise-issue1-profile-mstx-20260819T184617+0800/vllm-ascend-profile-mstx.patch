+    request_scoped: bool = False,
+) -> Iterator[None]:
+    range_id = start_mstx_load_range(
+        stage,
+        step_id=step_id,
+        layer_id=layer_id,
+        tp_rank=tp_rank,
+        request_id=request_id,
+        request_scoped=request_scoped,
+    )
+    try:
+        yield
+    finally:
+        end_mstx_load_range(range_id)
