# These pre-fix transcripts are immutable byte evidence with trailing spaces.
tooling/command-transcript.log binary
tooling-r2/command-transcript.log binary

# BuildKit preserves terminal progress bytes that are not normalized text.
image-*/build.log binary

# nerdctl inspect emits a trailing blank line; preserve the raw JSON bytes.
image-*/image-inspect*.json binary

# vLLM banners contain CR bytes and ps uses fixed-width trailing padding.
g0/*-engine.log binary
g0/*-process-state.txt binary
g4/vllm-*.log binary
smoke/runner-output/vllm-*.log binary
smoke/diagnostics/cold-vllm-decode.log binary
