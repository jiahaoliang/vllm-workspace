COMMAND python3 -c $'\nimport json, re, sys\nfrom pathlib import Path\nroot = Path(sys.argv[1])\nsummary = json.loads((root / "range-debug-summary.json").read_text())\nexpected = list(range(27))\nassert summary["status"] == "passed" and summary["errors"] == []\nassert summary["prefill"] == {"commit_event_count": 1, "event_count": 28, "range_event_count": 27, "range_layers": expected, "whole_key_event_count": 0}\nassert summary["decode"] == {"commit_event_count": 0, "event_count": 27, "range_event_count": 27, "range_layers": expected, "whole_key_event_count": 0}\nresponse = json.loads((root / "response.json").read_text())\nassert response["choices"][0]["finish_reason"] == "length"\nassert response["usage"] == {"prompt_tokens": 525, "completion_tokens": 16, "total_tokens": 541}\nfor role in ("prefill", "decode"):\n    log = (root / f"vllm-{role}.log").read_text()\n    assert log.count("POST /v1/completions HTTP/1.1\\" 200 OK") == 1\n    assert "Traceback (most recent call last)" not in log and "TypeError" not in log\n    events = [json.loads(line.split("[KVPOOL_RANGE_DEBUG]", 1)[1].strip()) for line in log.splitlines() if "[KVPOOL_RANGE_DEBUG]" in line]\n    ranges = [event for event in events if event["event"] == "range"]\n    assert len(ranges) == 27\n    for event in ranges:\n        assert event["key_count"] == 4\n        assert len(event["sizes"]) == len(event["requested_bytes"]) == len(event["results"]) == 4\n        assert all(requested == sum(sizes) == result for requested, sizes, result in zip(event["requested_bytes"], event["sizes"], event["results"]))\nprefill_events = [json.loads(line.split("[KVPOOL_RANGE_DEBUG]", 1)[1].strip()) for line in (root / "vllm-prefill.log").read_text().splitlines() if "[KVPOOL_RANGE_DEBUG]" in line]\ncommit_indexes = [index for index, event in enumerate(prefill_events) if event["event"] == "commit"]\nassert commit_indexes == [27]\nassert prefill_events[27]["layer_id"] == 26 and prefill_events[27]["results"] == [0, 0, 0, 0]\ndecode_log = (root / "vllm-decode.log").read_text()\nassert "kvpool hit tokens: 512, need to load: 512" in decode_log\nmetrics = (root / "post-request.metrics").read_text()\nvalues = {}\nfor name in ("master_key_count", "master_allocated_bytes", "master_active_clients", "master_batch_put_start_requests_total", "master_batch_put_end_requests_total"):\n    match = re.search(rf"^{name} ([0-9.eE+-]+)$", metrics, re.M)\n    assert match\n    values[name] = float(match.group(1))\nassert values["master_key_count"] == 4 and values["master_allocated_bytes"] > 0\nassert values["master_active_clients"] == 2\nassert values["master_batch_put_start_requests_total"] == 1\nassert values["master_batch_put_end_requests_total"] == 1\nprint(json.dumps({"validated": True, "num_layers": 27, "prefill_commits": 1, "whole_key_calls": 0, "response_id": response["id"], "metrics": values}, indent=2, sort_keys=True))' /root/ljh/vllm-workspace/features/kv-pool-layerwise-reuse/evidence/full-validation-rerun-20260807T100722Z/g4
