{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "prefill-engine-deployment",
    "namespace": "liangjiahao"
  },
  "spec": {
    "progressDeadlineSeconds": 600,
    "replicas": 1,
    "revisionHistoryLimit": 10,
    "selector": {
      "matchLabels": {
        "app": "prefill"
      }
    },
    "strategy": {
      "type": "Recreate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "prefill"
        }
      },
      "spec": {
        "containers": [
          {
            "args": [
              "exec sleep infinity"
            ],
            "command": [
              "/bin/bash",
              "-lc"
            ],
            "env": [
              {
                "name": "POD_NAME",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "metadata.name"
                  }
                }
              },
              {
                "name": "POD_IP",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "status.podIP"
                  }
                }
              },
              {
                "name": "HCCL_IF_IP",
                "valueFrom": {
                  "fieldRef": {
                    "apiVersion": "v1",
                    "fieldPath": "status.podIP"
                  }
                }
              },
              {
                "name": "GLOO_SOCKET_IFNAME",
                "value": "eth0"
              },
              {
                "name": "TP_SOCKET_IFNAME",
                "value": "eth0"
              },
              {
                "name": "HCCL_SOCKET_IFNAME",
                "value": "eth0"
              },
              {
                "name": "HCCL_INTRA_ROCE_ENABLE",
                "value": "1"
              },
              {
                "name": "ASCEND_BUFFER_POOL",
                "value": "4:8"
              },
              {
                "name": "MOONCAKE_CONFIG_PATH",
                "value": "/opt/vllm-layerwise/mooncake.json"
              },
              {
                "name": "MOONCAKE_MASTER",
                "value": "mooncake-master-service:30089"
              },
              {
                "name": "PYTHONUNBUFFERED",
                "value": "1"
              },
              {
                "name": "PYTHONHASHSEED",
                "value": "0"
              },
              {
                "name": "PYTHONDONTWRITEBYTECODE",
                "value": "1"
              }
            ],
            "image": "docker.io/library/vllm-ascend:kv-pool-layerwise-main-54503ece-a2-57d3c214e-df3f74ed-20260811T145302Z",
            "imagePullPolicy": "Never",
            "name": "prefill-engine",
            "ports": [
              {
                "containerPort": 8100,
                "name": "prefill-port",
                "protocol": "TCP"
              }
            ],
            "readinessProbe": {
              "failureThreshold": 120,
              "httpGet": {
                "path": "/v1/models",
                "port": "prefill-port",
                "scheme": "HTTP"
              },
              "periodSeconds": 5,
              "successThreshold": 1,
              "timeoutSeconds": 2
            },
            "resources": {
              "limits": {
                "huawei.com/Ascend910": "2"
              },
              "requests": {
                "huawei.com/Ascend910": "2"
              }
            },
            "terminationMessagePath": "/dev/termination-log",
            "terminationMessagePolicy": "File",
            "volumeMounts": [
              {
                "mountPath": "/dev/shm",
                "name": "shm"
              },
              {
                "mountPath": "/usr/local/dcmi",
                "name": "dcmi"
              },
              {
                "mountPath": "/usr/local/bin/npu-smi",
                "name": "npusmi"
              },
              {
                "mountPath": "/usr/local/Ascend/driver/lib64",
                "name": "driver-lib64"
              },
              {
                "mountPath": "/usr/local/Ascend/driver/version.info",
                "name": "driver-version"
              },
              {
                "mountPath": "/etc/ascend_install.info",
                "name": "ascend-install-info"
              },
              {
                "mountPath": "/root/.cache",
                "name": "model-cache"
              },
              {
                "mountPath": "/usr/bin/hccn_tool",
                "name": "hccn-tool"
              },
              {
                "mountPath": "/etc/hccn.conf",
                "name": "hccn-conf"
              },
              {
                "mountPath": "/opt/vllm-layerwise",
                "name": "runtime-config",
                "readOnly": true
              }
            ]
          }
        ],
        "dnsPolicy": "ClusterFirst",
        "nodeName": "m1",
        "restartPolicy": "Always",
        "schedulerName": "default-scheduler",
        "securityContext": {},
        "terminationGracePeriodSeconds": 120,
        "volumes": [
          {
            "emptyDir": {
              "medium": "Memory",
              "sizeLimit": "24Gi"
            },
            "name": "shm"
          },
          {
            "hostPath": {
              "path": "/usr/local/dcmi",
              "type": "Directory"
            },
            "name": "dcmi"
          },
          {
            "hostPath": {
              "path": "/usr/local/bin/npu-smi",
              "type": "File"
            },
            "name": "npusmi"
          },
          {
            "hostPath": {
              "path": "/usr/local/Ascend/driver/lib64",
              "type": "Directory"
            },
            "name": "driver-lib64"
          },
          {
            "hostPath": {
              "path": "/usr/local/Ascend/driver/version.info",
              "type": "File"
            },
            "name": "driver-version"
          },
          {
            "hostPath": {
              "path": "/etc/ascend_install.info",
              "type": "File"
            },
            "name": "ascend-install-info"
          },
          {
            "hostPath": {
              "path": "/home/llm_cache",
              "type": "Directory"
            },
            "name": "model-cache"
          },
          {
            "hostPath": {
              "path": "/usr/bin/hccn_tool",
              "type": "File"
            },
            "name": "hccn-tool"
          },
          {
            "hostPath": {
              "path": "/etc/hccn.conf",
              "type": "File"
            },
            "name": "hccn-conf"
          },
          {
            "configMap": {
              "defaultMode": 365,
              "name": "layerwise-performance-dp1-16384-reuse3"
            },
            "name": "runtime-config"
          }
        ]
      }
    }
  }
}
